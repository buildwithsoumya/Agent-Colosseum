# ---------------------------------------------------------------------------
# Agent Colosseum — environment configuration (copy to .env and adjust)
# Never commit real credentials.
# ---------------------------------------------------------------------------

# Node environment
NODE_ENV=development
LOG_LEVEL=debug

# Backend
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL (docker compose service "postgres")
POSTGRES_USER=colosseum
POSTGRES_PASSWORD=colosseum_dev_pw
POSTGRES_DB=agent_colosseum
DATABASE_URL=postgresql://colosseum:colosseum_dev_pw@localhost:5432/agent_colosseum?schema=public

# Redis (docker compose service "redis")
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -hex 48
AUTH_SECRET=change-me-generate-a-long-random-hex-string
SESSION_TTL_HOURS=24

# Seed admin bootstrap (used by `npm run db:seed` for the demo event)
SEED_ADMIN_EMAIL=admin@colosseum.dev
SEED_ADMIN_PASSWORD=admin123

# Storage abstraction: local | s3  (local writes to ./data/uploads, no AWS needed)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Evaluator
EVALUATOR_MODE=simulated          # simulated | docker (docker = future container execution)
EVALUATOR_QUEUE_NAME=gauntlet
EVALUATOR_CONCURRENCY=2
GAUNTLET_PAYLOAD_COUNT=10

# Optional error monitoring (leave empty to disable Sentry)
SENTRY_DSN=
