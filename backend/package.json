{
  "name": "@ac/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node ../scripts/with-env.mjs prisma generate",
    "db:migrate": "node ../scripts/with-env.mjs prisma migrate deploy",
    "db:migrate:dev": "node ../scripts/with-env.mjs prisma migrate dev",
    "db:seed": "node ../scripts/with-env.mjs tsx prisma/seed.ts",
    "db:studio": "node ../scripts/with-env.mjs prisma studio",
    "predev": "node ../../scripts/with-env.mjs prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ac/shared": "workspace:*",
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.4.2",
    "multer": "^2.0.1",
    "pino": "^9.6.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "pino-pretty": "^13.0.0"
  }
}